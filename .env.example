# Copy to .env for local development. Never commit .env.
DJANGO_DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Host port for the Compose PostgreSQL container (change if 5432 is taken).
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgres://houseledger:houseledger@localhost:5432/houseledger
REDIS_URL=redis://localhost:6379/0
# Use Redis as the cache so rate limits are shared across processes.
CACHE_URL=rediscache://localhost:6379/1

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HouseLedger <no-reply@localhost>
SITE_URL=http://localhost:8000
TIME_ZONE=America/New_York

# Development only: password for `python manage.py seed_demo` demo accounts.
DEMO_USER_PASSWORD=
